# Copia este archivo como ".env" y cambia los valores antes de desplegar a produccion

PORT=3000

# Secreto usado para firmar los tokens de sesion (JWT). Genera uno propio, largo y aleatorio.
JWT_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

# Credenciales del administrador
# RUT sin puntos, con guion. Ejemplo: 11111111-1
ADMIN_RUT=11111111-1

# Password del administrador, ya hasheado con bcrypt (nunca en texto plano).
# Genera tu propio hash ejecutando, despues de "npm install":
#   npm run hash -- "admin123"
# y pega aqui el resultado que imprime la consola.
ADMIN_PASSWORD_HASH=PEGA_AQUI_EL_HASH_GENERADO
